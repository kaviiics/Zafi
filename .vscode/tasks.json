{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zafi Build x64-debug",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/build-debug.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$msvc"]
    }
  ]
}
